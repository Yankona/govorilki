  "old": "const hiS = (s, ch) => esc(s).replace(new RegExp('[' + ch.toLowerCase() + ch.toUpperCase() + ']', 'g'), '<b class=\"r\">$&</b>');",
  "new": "// which letters to highlight: in Russian the letters themselves; elsewhere LANGDATA.HI_RE gives a regex per sound key\n// (r, l, sh, ch, j, sz, shf = the whole hushing family, and the SND_HI groups); Russian code letters map to those keys\nconst HI_RE = LX('HI_RE', null);\nfunction hiRe(ch) {\n  if (!HI_RE) return new RegExp('[' + ch.toLowerCase() + ch.toUpperCase() + ']', 'g');\n  const s = ch.toLowerCase().replace(/[шжчщ]{2,}/g, 'shf').replace(/[рлшжчщсз]/g, c => ({ 'р': 'r', 'л': 'l', 'ш': 'sh', 'ж': 'j', 'ч': 'ch', 'щ': 'sh', 'с': 'sz', 'з': 'sz' })[c]);\n  const keys = Object.keys(HI_RE), byLen = [...keys].sort((a, b) => b.length - a.length), got = new Set(), extra = [];\n  for (let i = 0; i < s.length;) {\n    const k = byLen.find(x => s.startsWith(x, i));\n    if (k) { got.add(k); i += k.length; continue; }\n    if (/\\p{L}/u.test(s[i]) && !extra.includes(s[i])) extra.push(s[i]);\n    i++;\n  }\n  const parts = [...new Set([...keys.filter(k => got.has(k)).map(k => HI_RE[k]), ...extra])];\n  return new RegExp(parts.join('|') || '(?!)', 'giu');\n}\nconst hiS = (s, ch) => esc(s).replace(hiRe(ch), '<b class=\"r\">$&</b>');"
 },
