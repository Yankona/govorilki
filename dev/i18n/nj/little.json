 "<div class=\"winbox lt-win\" role=\"dialog\" aria-label=\"Шаг готов\"><div class=\"ryz-w lt-dance\">{0}</div>\n      <h2>Ура! Шаг готов!</h2><div class=\"lt-stk\"><span class=\"emo\">{1}</span></div><p class=\"win-line\">Наклейка дня — на тропу!</p>\n      <div class=\"win-btns\"><button class=\"big\" data-a=\"home\">Дальше!</button></div></div>": [
  "<div class=\"winbox lt-win\" role=\"dialog\" aria-label=\"Step done\"><div class=\"ryz-w lt-dance\">{0}</div>\n      <h2>Hooray! The step is done!</h2><div class=\"lt-stk\"><span class=\"emo\">{1}</span></div><p class=\"win-line\">Sticker of the day, onto the path!</p>\n      <div class=\"win-btns\"><button class=\"big\" data-a=\"home\">Next!</button></div></div>",
  "<div class=\"winbox lt-win\" role=\"dialog\" aria-label=\"Passo feito\"><div class=\"ryz-w lt-dance\">{0}</div>\n      <h2>Viva! O passo está feito!</h2><div class=\"lt-stk\"><span class=\"emo\">{1}</span></div><p class=\"win-line\">O autocolante do dia vai para o trilho!</p>\n      <div class=\"win-btns\"><button class=\"big\" data-a=\"home\">Em frente!</button></div></div>",
  "<div class=\"winbox lt-win\" role=\"dialog\" aria-label=\"Schritt geschafft\"><div class=\"ryz-w lt-dance\">{0}</div>\n      <h2>Hurra! Der Schritt ist geschafft!</h2><div class=\"lt-stk\"><span class=\"emo\">{1}</span></div><p class=\"win-line\">Der Sticker des Tages kommt auf den Pfad!</p>\n      <div class=\"win-btns\"><button class=\"big\" data-a=\"home\">Weiter!</button></div></div>"
 ],
